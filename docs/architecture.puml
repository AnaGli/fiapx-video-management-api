@startuml
' Configurações Visuais Offline-Friendly
skinparam componentStyle rectangle
skinparam databaseBackgroundColor #E3F2FD
skinparam packageBackgroundColor white
skinparam nodeBackgroundColor #FAFAFA

title Architecture Design (Runtime Environment)

actor "End User" as user

node "AWS Cloud (Region: us-east-1)" {
    
    node "VPC (Virtual Private Cloud)" {
        
        package "Public Subnet (DMZ)" {
            [Classic Load Balancer (ELB)] as elb
        }
        
        package "Private Subnet (Workloads)" {
            
            node "EKS Cluster (Control Plane)" as eks {
                
                ' Camada de Infraestrutura (EC2)
                node "EC2 Worker Nodes\n(Managed Node Group)" as ec2 {
                    
                    package "K8s Namespace" {
                        [FastAPI App Pods (HPA 1-10)] as api
                        [Metrics Server] as metrics
                        database "PostgreSQL Pod" as db
                        
                        ' Definição de Serviços Lógicos
                        () "FastAPI Service" as api_svc
                        () "Postgres Service" as db_svc
                    }
                }
            }
        }
    }
}

' Fluxo de Tráfego e Dados
user -down-> elb : HTTP Request (Port 80)
elb -down-> api_svc : Forward to ClusterIP
api_svc -down-> api : Load Balance
api -down-> db_svc : TCP Connection (Port 5432)
db_svc -down-> db : SQL Query

' Fluxo de Monitoramento e Auto-scaling
metrics .right.> api : Monitor CPU/RAM
metrics -[#red]left-> api : Scale (HPA Trigger)
@enduml